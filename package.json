{
  "name": "@craiglington/sapling",
  "version": "1.1.0-1",
  "description": "A simple front-end library.",
  "main": "src/dist/index.js",
  "types": "src/dist/index.d.ts",
  "scripts": {
    "build": "npx tsc",
    "prettier": "npx prettier . --write",
    "start": "npx tsc --watch",
    "test": "npx tsc -p spec && npx jasmine-browser-runner runSpecs",
    "test-serve": "npx tsc -p spec && npx jasmine-browser-runner serve",
    "release": "npm publish --access public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Craiglington/sapling.git"
  },
  "author": "Craiglington",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Craiglington/sapling/issues"
  },
  "homepage": "https://github.com/Craiglington/sapling#readme",
  "devDependencies": {
    "@types/jasmine": "6.0.0",
    "jasmine-browser-runner": "5.0.0",
    "jasmine-core": "7.0.2",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  }
}
