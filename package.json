{
  "name": "@craiglington/sapling",
  "version": "1.1.0-1",
  "description": "A simple front-end library.",
  "main": "src/dist/index.js",
  "types": "src/dist/index.d.ts",
  "scripts": {
    "start": "npx tsc --build --watch",
    "build": "npx tsc --build",
    "test": "npm run build && npx jasmine-browser-runner runSpecs",
    "test:serve": "npm run build && npx jasmine-browser-runner serve",
    "release": "npm run build && npm publish --access public",
    "prettier:check": "npx prettier . --check",
    "prettier": "npx prettier . --write",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Craiglington/sapling.git"
  },
  "author": "Craiglington",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Craiglington/sapling/issues"
  },
  "type": "module",
  "homepage": "https://github.com/Craiglington/sapling#readme",
  "devDependencies": {
    "@types/jasmine": "6.0.0",
    "@types/serve-static": "2.2.0",
    "husky": "^9.1.7",
    "jasmine-browser-runner": "5.0.0",
    "jasmine-core": "7.0.2",
    "prettier": "3.9.6",
    "serve-static": "2.2.1",
    "typescript": "7.0.2"
  }
}
